---
import { hero, author } from '@/config.json'
import { SocialList } from './SocialList'
import Highlight from '@/components/Highlight.astro'
---

<div class="lg:-mt-16 lg:h-dvh lg:min-h-[720px]">
  <div
    class="relative max-w-[1300px] mx-auto h-full px-4 grid lg:grid-cols-2 items-center justify-items-center"
  >
    <div class="mt-[120px] lg:mt-0 max-w-[590px]">
      <h1 class="text-3xl text-center lg:text-left text-balance">
        Hi, I'm <Highlight class="font-bold">{hero.name}</Highlight><br />
        Welcome to my <Highlight class="font-bold">academic homepage</Highlight>
      </h1>
      <h2 class="text-xl mt-4 text-center lg:text-left text-balance">{hero.description}</h2>
      <p class="text-sm mt-2 text-center lg:text-left text-secondary">Affiliation: Zhejiang University</p>
      <div class="text-sm text-secondary mt-6 text-center lg:text-left">
        Research areas: Embodied Intelligence, Autonomous Driving, and Robotics.<br />
        This website documents publications, projects, and ongoing milestones.
      </div>
      <SocialList className="mt-[40px]" client:load />
    </div>
    <div class="mt-20 lg:mt-0">
      <div
        class="size-[200px] lg:size-[300px] rounded-full overflow-hidden border border-primary bg-zinc-100 dark:bg-zinc-800"
      >
        <img class="size-full" src={author.avatar} alt="Site avatar" loading="lazy" />
      </div>
    </div>

    <div class="mt-10 lg:mt-0 lg:absolute inset-x-0 bottom-0 flex flex-col items-center">
      <p class="text-xxs text-center text-balance text-secondary">{hero.yiyan}</p>
      <div class="mt-7 text-xl animate-bounce">
        <i class="iconfont icon-down"></i>
      </div>
    </div>
  </div>
</div>
