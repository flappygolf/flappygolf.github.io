---
import type { CollectionEntry } from 'astro:content'
import PostCard from './PostCard.astro'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
---

<div>
  {
    posts.length === 0 ? (
      <p class="text-secondary">No posts yet. Add your first publication or research note.</p>
    ) : (
      <ul class="-my-4">
        {posts.map((post) => (
          <li>
            <PostCard entry={post} />
          </li>
        ))}
      </ul>
    )
  }
</div>
